---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHeader from "~/components/ui/PageHeader.astro";
import DictionaryTable from "~/components/islands/DictionaryTable.vue";
import type { DictRow } from "~/components/islands/DictionaryTable.vue";
import { listDictionaries } from "~/lib/dictionary";
import { loadDictionary } from "~/lib/data";
import { ENTITY_TYPE_ORDER } from "~/lib/entityTypeMeta";
import { dictLicenseRegime } from "~/lib/licensing";

const allDicts = listDictionaries();

const rows: DictRow[] = allDicts.map((d) => {
  const bundle = loadDictionary(d.slug);
  const byType: Record<string, number> = {};
  for (const type of ENTITY_TYPE_ORDER) {
    byType[type] = bundle.entityCount(type);
  }
  const totalEntities = Object.values(byType).reduce((s, n) => s + n, 0);
  const totalVersions = bundle.entitiesOfType("class").filter((n: any) => n.version_history && n.version_history.length > 0).length +
    bundle.entitiesOfType("property").filter((n: any) => n.version_history && n.version_history.length > 0).length;

  return {
    slug: d.slug,
    title: d.title,
    shortTitle: d.shortTitle,
    parcelId: d.parcelId,
    publicationId: d.publicationId,
    edition: d.edition,
    technicalCommittee: d.technicalCommittee,
    publishedYear: String(d.publishedYear ?? ""),
    webstoreUrl: d.webstoreUrl,
    abstract: d.abstract,
    totalEntities,
    byType,
    totalVersions,
    multiVersionEntities: totalVersions,
    demonstration: d.demonstration === true,
    profile: d.profile,
  };
});

// Categorised by role: our learning resources first, then the IEC
// reference data — freely licensed in full for the units dictionary,
// §5 free attributes for the rest.
const categories: Array<{
  id: string;
  heading: string;
  caption: string;
  rows: DictRow[];
}> = [
  {
    id: "opencdd-own",
    heading: "OpenCDD learning resources — demonstration dictionaries",
    caption:
      "Authored by OpenCDD to teach the CDD meta-model — not IEC content. OceanRunner demonstrates product-line configuration modelling (option powertypes, configured subclasses, conditional properties); ScenicSpots and Antiques demonstrate power-typed ontologies with registered real-world individuals and native multilingual names. Their measured properties reference the IEC 62720 units dictionary directly and cross-link to it. Full data, BSD-3-Clause, like the rest of our code.",
    rows: rows.filter((r) => dictLicenseRegime(r.slug) === "opencdd-own"),
  },
  {
    id: "eula-full",
    heading: "Reference data — IEC 62720 units dictionary (fully free)",
    caption:
      "Reference data, free in its entirety under IEC CDD License Agreement § 6: every attribute of the quantities-and-units dictionary, with IEC referenced as the source. This is the dictionary our learning resources link their units to.",
    rows: rows.filter((r) => dictLicenseRegime(r.slug) === "eula-full"),
  },
  {
    id: "eula-free-attributes",
    heading: "Reference data — IEC CDD dictionaries (§ 5 free attributes)",
    caption:
      "Real IEC CDD data for reference only, served strictly as the FREE ATTRIBUTES of the IEC CDD License Agreement § 5 — identities, names, value formats, structure. Definitions and other reserved attributes are not served; get them from cdd.iec.ch or run OpenCDD yourself. To learn the meta-model, start with the demonstration dictionaries above.",
    rows: rows.filter((r) => dictLicenseRegime(r.slug) === "eula-free-attributes"),
  },
].filter((c) => c.rows.length > 0);
---

<BaseLayout
  title="Dictionaries — OpenCDD"
  description="All dictionaries in the OpenCDD browser — OpenCDD's own demonstration data, the freely licensed IEC 62720 units dictionary, and the IEC CDD dictionaries served as free attributes."
>
  <article class="mx-auto max-w-6xl space-y-10">
    <PageHeader
      kicker="Dictionaries"
      title="Every dictionary in the OpenCDD browser"
      description="Our own demonstration dictionaries first, then the IEC CDD dictionaries — sortable, filterable, and linked to the canonical IEC publication. Click any column header to sort. Click a dictionary name to browse its entities."
    />

    {categories.map((cat) => (
      <section class="space-y-3" aria-labelledby={`dictcat-${cat.id}`}>
        <div class="space-y-1 border-b border-paper-300 pb-3">
          <h2 id={`dictcat-${cat.id}`} class="font-display text-xl tracking-tight text-ink-900">
            {cat.heading}
            {" "}
            <span class="ml-1.5 align-middle font-mono text-sm font-normal text-ink-400">
              ({cat.rows.length})
            </span>
          </h2>
          <p class="text-xs leading-relaxed text-ink-500">
            {cat.caption}{" "}
            <a href="/licensing/" class="underline underline-offset-2 hover:text-ink-700">Data &amp; licensing</a>
            {" "}·{" "}
            <a href="/get-the-data/" class="underline underline-offset-2 hover:text-ink-700">Get the full data</a>
          </p>
        </div>
        <DictionaryTable client:load rows={cat.rows} />
      </section>
    ))}
  </article>
</BaseLayout>
